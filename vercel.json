{
  "version": 2,
  "builds": [
    {
      "src": "webapp/main.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "webapp/main.py"
    }
  ],
  "functions": {
    "webapp/main.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "PYTHONPATH": "."
  }
}
